<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090909"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="28dp">

    <ImageView
        android:id="@+id/lock_logo"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:contentDescription="LazcaKong Gym"
        android:src="@mipmap/ic_launcher" />

    <TextView
        android:id="@+id/lock_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.16"
        android:text="LAZCAKONG GYM"
        android:textColor="#CCFF00"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="DESCANSO TERMINADO"
        android:textColor="#F5F5F5"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/lock_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Descanso finalizado. Continúa tu entrenamiento."
        android:textColor="#D4D4D8"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btn_continue_workout"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="36dp"
        android:backgroundTint="#CCFF00"
        android:text="CONTINUAR ENTRENAMIENTO"
        android:textAllCaps="true"
        android:textColor="#090909"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btn_dismiss_alert"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#171717"
        android:text="CERRAR AVISO"
        android:textAllCaps="true"
        android:textColor="#F5F5F5"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
