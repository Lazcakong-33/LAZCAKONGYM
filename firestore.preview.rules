rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /invites/{inviteId} {
      allow read, write: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'kmiloko19@gmail.com'
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /athletes/{athleteId} {
      function isPreviewOwner() {
        return request.auth != null && request.auth.uid == athleteId;
      }

      function isLinkedOwner() {
        return request.auth != null && resource != null && resource.data.get('authUid', '') == request.auth.uid;
      }

      function validPreviewDocument() {
        let data = request.resource.data;
        return data.get('id', athleteId) == athleteId
          && !data.keys().hasAny([
            'isAdmin', 'pin', 'migrationStatus',
            'legacyPinPurged', 'serverIdentityVerified'
          ]);
      }

      allow get: if isLinkedOwner() || (isPreviewOwner() && (resource == null || !resource.data.keys().hasAny(['authUid'])));
      allow list: if request.auth != null && resource.data.authUid == request.auth.uid
        && request.query.limit <= 2;
      allow create: if isPreviewOwner() && validPreviewDocument()
        && !request.resource.data.keys().hasAny(['authUid']);
      allow update: if (isLinkedOwner() || (isPreviewOwner() && !resource.data.keys().hasAny(['authUid'])))
        && validPreviewDocument()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid']);
    }
  }
}
