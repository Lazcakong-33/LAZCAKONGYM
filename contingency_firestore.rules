rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // LAZCAKONG GYM - REGLAS DE CONTINGENCIA Y ROLLBACK SEGURO
    // AISLAMIENTO ESTRICTO POR ATLETA - ESCRITURAS CONGELADAS PARA NO-ADMINS
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Autorización administrativa estrictamente mediante cuenta Google verificada autorizada (Starter Tier)
    function isAdmin() {
      return isAuthenticated() &&
        ('email_verified' in request.auth.token) &&
        request.auth.token.email_verified == true &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string &&
        request.auth.token.email.lower() == 'kmiloko19@gmail.com' &&
        ('firebase' in request.auth.token) &&
        request.auth.token.firebase.get('sign_in_provider', '') == 'google.com';
    }
    
    function isOwner(athleteId) {
      return isAuthenticated() && (
        request.auth.uid == athleteId ||
        (resource != null && resource.data.get('authUid', '') == request.auth.uid)
      );
    }

    // During contingency, reads remain STRICTLY ISOLATED per athlete.
    // Client writes are suspended (frozen) to protect data integrity, allowing only Admin operations.
    match /athletes/{athleteId} {
      allow read: if isAdmin() || isOwner(athleteId);
      allow write: if isAdmin();

      match /push_subscriptions/{deviceId} {
        allow read: if isAdmin() || (isAuthenticated() && resource.data.authUid == request.auth.uid);
        allow write: if isAdmin();
      }

      match /rest_alarms/{restId} {
        allow read: if isAdmin() || (isAuthenticated() && resource.data.authUid == request.auth.uid);
        allow write: if isAdmin();
      }
    }
    
    match /athlete_credentials/{athleteId} {
      allow read, write: if false;
    }
    
    match /security_audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    match /deleted_athletes/{athleteId} {
      allow read: if isAdmin() || (isAuthenticated() && (request.auth.uid == athleteId || (resource != null && resource.data.get('authUid', '') == request.auth.uid)));
      allow write: if isAdmin();
    }
    
    match /users/{uid} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow create: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == uid && 
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin != true) && 
        request.resource.data.uid == uid &&
        request.resource.data.keys().hasAll(['uid', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['uid', 'createdAt', 'name', 'email', 'displayName', 'photoURL', 'settings', 'preferences'])
      );
      allow update: if isAdmin() || (
        isAuthenticated() && 
        request.auth.uid == uid && 
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.get('isAdmin', false)) && 
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'displayName', 'photoURL', 'settings', 'preferences', 'updatedAt'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
    }
    
    match /invites/{inviteId} {
      allow read, write: if isAdmin();
    }
  }
}
