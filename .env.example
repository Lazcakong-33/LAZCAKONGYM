# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for automated dispatch of access codes via Resend email service.
# Get your free key at https://resend.com/api-keys
RESEND_API_KEY="re_123456789"

# RESEND_FROM_EMAIL: Sender email address configured in Resend (default: LAZCAKONGYM <onboarding@resend.dev>).
RESEND_FROM_EMAIL="LAZCAKONGYM <onboarding@resend.dev>"

# MERCADOPAGO_ACCESS_TOKEN: Production or Sandbox access token from Mercado Pago Developers dashboard.
# Used to verify payment ID and extract payer details if not sent in the webhook notification body.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxx"

# ==============================================================================
# WEB PUSH & PERSISTENT BACKGROUND REST TIMER DISPATCH (Locked Screen Alerts)
# ==============================================================================
# VAPID_PUBLIC_KEY & VAPID_PRIVATE_KEY: Generate once with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:kmiloko19@gmail.com"

# FIREBASE_SERVICE_ACCOUNT_JSON (OPTIONAL FALLBACK ONLY):
# The server tries Google Cloud Application Default Credentials (ADC) / Cloud Run service identity first
# and only needs IAM role `roles/datastore.user` on project `forward-cortex-1ds98` (no JSON key download needed).
# Only set FIREBASE_SERVICE_ACCOUNT_JSON if cross-project IAM cannot be granted to the runtime service account.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# PUSH_DISPATCH_SECRET: Shared HMAC/Bearer secret verified on POST /api/push/dispatch-rest-alarm
PUSH_DISPATCH_SECRET=""

# Persistent Delayed Task Scheduler (choose ONE; Cloud Run in-memory setTimeout is never used):
# Option A (Recommended on Google Cloud): Google Cloud Tasks queue path
# Example: projects/forward-cortex-1ds98/locations/us-east1/queues/lazcakong-rest-alarms
CLOUD_TASKS_QUEUE_PATH=""
# Optional Cloud Tasks OIDC service account email (if Cloud Run / Cloud Tasks uses OIDC verification)
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=""

# Option B (Alternative HTTP delayed queue): Upstash QStash token
QSTASH_TOKEN=""

# ==============================================================================
# CAPACITOR NATIVE SHELL (ANDROID / IOS)
# IMPORTANTE: Todas las variables VITE_* quedan visibles en el bundle JS compilado (dist/).
# Nunca coloques claves privadas, tokens ni secretos de servidor en variables VITE_*.
# ==============================================================================
# Backend permanente Cloud Run usado por las WebViews nativas de Capacitor (NUNCA ais-dev-* ni ais-pre-*)
VITE_API_BASE_URL="https://lazcakongym.ai.studio"
# Web OAuth 2.0 Client ID (público) de Firebase / Google Cloud para Google Sign-In nativo
VITE_GOOGLE_WEB_CLIENT_ID="13537846485-8j7931cki5gtlpq2eklsru35765sv3pq.apps.googleusercontent.com"
# Opcional: orígenes extra autorizados en CORS separados por coma
CORS_ALLOWED_ORIGINS="https://localhost,capacitor://localhost,ionic://localhost,https://lazcakongym.ai.studio,https://lazcakongym-13537846485.us-east1.run.app"

# ==============================================================================
# ACTUALIZACIONES OTA CAPACITOR (SOLO DESARROLLO HASTA AUTORIZACIÓN EXPLÍCITA)
# ==============================================================================
OTA_DEV_CHANNEL_ENABLED="true"
OTA_PRODUCTION_ENABLED="false"
VITE_OTA_CHANNEL="development"
VITE_OTA_PRODUCTION_ENABLED="false"

