# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required for automated dispatch of access codes via Resend email service.
# Get your free key at https://resend.com/api-keys
RESEND_API_KEY="re_123456789"

# RESEND_FROM_EMAIL: Sender email address configured in Resend (default: LAZCAKONGYM <onboarding@resend.dev>).
RESEND_FROM_EMAIL="LAZCAKONGYM <onboarding@resend.dev>"

# MERCADOPAGO_ACCESS_TOKEN: Production or Sandbox access token from Mercado Pago Developers dashboard.
# Used to verify payment ID and extract payer details if not sent in the webhook notification body.
MERCADOPAGO_ACCESS_TOKEN="APP_USR-xxxxxx"


# Optional server-side model override (text, images and PDF).
GEMINI_MODEL="gemini-3.8-flash"

# Server-only administrator allowlist (required for administrative access).
ADMIN_EMAILS=""
FIREBASE_PROJECT_ID="demo-lazcakong"
FIREBASE_DATABASE_ID="(default)"

# Firebase browser configuration (public identifiers, not server secrets).
VITE_FIREBASE_PROJECT_ID="demo-lazcakong"
VITE_FIREBASE_API_KEY="demo-api-key"
VITE_FIREBASE_APP_ID="1:000000000000:web:demo"
VITE_FIREBASE_AUTH_DOMAIN="demo-lazcakong.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="demo-lazcakong.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_DATABASE_ID="(default)"
