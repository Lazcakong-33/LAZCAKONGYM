{
  "entities": {
    "AthleteProfile": {
      "title": "AthleteProfile",
      "description": "Registered athlete account, credentials, routines, workout history, personal records, and body weight logs.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique profile ID" },
        "name": { "type": "string", "description": "Athlete full name" },
        "email": { "type": "string", "description": "Athlete login email" },
        "pin": { "type": "string", "description": "Secret 4-6 digit login PIN" },
        "avatar": { "type": "string", "description": "Emoji avatar" },
        "goal": { "type": "string", "description": "Primary fitness goal" },
        "weeklyTargetDays": { "type": "number", "description": "Target training days per week" },
        "isAdmin": { "type": "boolean", "description": "Whether user is coach/admin" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "lastSyncedAt": { "type": "string", "description": "ISO sync timestamp" }
      },
      "required": ["id", "name", "email", "pin"]
    },
    "InviteLink": {
      "title": "InviteLink",
      "description": "Single-use invitation token generated exclusively by the Administrator. Expires immediately after 1 use.",
      "type": "object",
      "properties": {
        "token": { "type": "string", "description": "Unique single-use invitation token" },
        "createdAt": { "type": "string", "description": "ISO creation timestamp" },
        "createdBy": { "type": "string", "description": "Admin name or email" },
        "note": { "type": "string", "description": "Optional recipient label" },
        "used": { "type": "boolean", "description": "True once consumed by an athlete" },
        "usedAt": { "type": "string", "description": "ISO timestamp when consumed" },
        "usedByName": { "type": "string", "description": "Name of athlete who used the invite" },
        "usedByEmail": { "type": "string", "description": "Email of athlete who used the invite" },
        "revoked": { "type": "boolean", "description": "True if manually expired by Admin" }
      },
      "required": ["token", "createdAt", "createdBy", "used"]
    },
    "DeletedAthlete": {
      "title": "DeletedAthlete",
      "description": "Tombstone record of permanently deleted athletes to guarantee immediate multi-device synchronization and prevent stale local caching.",
      "type": "object",
      "properties": {
        "athleteId": { "type": "string", "description": "ID of the deleted athlete" },
        "deletedAt": { "type": "string", "description": "ISO timestamp of deletion" },
        "deletedBy": { "type": "string", "description": "Admin who performed the deletion" }
      },
      "required": ["athleteId", "deletedAt"]
    },
    "PushSubscription": {
      "title": "PushSubscription",
      "description": "Web Push subscription bound to an authenticated athlete and a specific browser/device.",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "athleteId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "endpoint": { "type": "string", "pattern": "^https://.*", "maxLength": 2048 },
        "keys": { "type": "object", "description": "ECDH p256dh and auth secrets" },
        "userAgent": { "type": "string", "maxLength": 350 },
        "platform": { "type": "string", "maxLength": 80 },
        "enabled": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["deviceId", "athleteId", "authUid", "endpoint", "keys", "enabled", "createdAt", "updatedAt"]
    },
    "RestAlarm": {
      "title": "RestAlarm",
      "description": "Persistent scheduled rest timer alarm tied to an authenticated athlete and unique restId.",
      "type": "object",
      "properties": {
        "restId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "athleteId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "authUid": { "type": "string", "maxLength": 128 },
        "deviceId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "maxLength": 128 },
        "sessionId": { "type": "string", "maxLength": 128 },
        "exerciseName": { "type": "string", "maxLength": 160 },
        "nextSetNumber": { "type": "number" },
        "targetEndTime": { "type": "number" },
        "durationSeconds": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["scheduled", "paused", "cancelled", "superseded", "sent", "failed"]
        },
        "mode": {
          "type": "string",
          "enum": ["sound", "vibrate_only", "silent"]
        },
        "restEndAlertEnabled": { "type": "boolean" },
        "isTest": { "type": "boolean" },
        "schedulerProvider": { "type": "string", "enum": ["cloud_tasks", "qstash", "none"] },
        "schedulerTaskName": { "type": "string", "maxLength": 512 },
        "dispatchAttemptCount": { "type": "number" },
        "providerAcceptedAt": { "type": "string", "maxLength": 64 },
        "providerStatus": { "type": "string", "maxLength": 160 },
        "invalidatedReason": { "type": "string", "maxLength": 160 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": [
        "restId",
        "athleteId",
        "authUid",
        "deviceId",
        "targetEndTime",
        "durationSeconds",
        "status",
        "mode",
        "restEndAlertEnabled",
        "isTest",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/athletes/{athleteId}": {
      "schema": { "$ref": "#/entities/AthleteProfile" },
      "description": "Global collection of registered athletes and their synced training data"
    },
    "/athletes/{athleteId}/push_subscriptions/{deviceId}": {
      "schema": { "$ref": "#/entities/PushSubscription" },
      "description": "Per-device Web Push subscriptions owned by the authenticated athlete"
    },
    "/athletes/{athleteId}/rest_alarms/{restId}": {
      "schema": { "$ref": "#/entities/RestAlarm" },
      "description": "Persistent scheduled rest timer alarms keyed by restId and checked for validity before dispatch"
    },
    "/deleted_athletes/{athleteId}": {
      "schema": { "$ref": "#/entities/DeletedAthlete" },
      "description": "Registry of deleted athletes ensuring instant cross-device purge and permanent removal"
    },
    "/invites/{inviteId}": {
      "schema": { "$ref": "#/entities/InviteLink" },
      "description": "Single-use invitation links created by the Administrator"
    }
  }
}
