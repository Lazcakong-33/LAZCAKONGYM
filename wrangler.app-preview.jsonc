{
  "name": "lazcakong-gym-app-preview",
  "main": "cloudflare/app-preview-worker.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "COACH_USER_LIMIT", "namespace_id": "6521901", "simple": { "limit": 4, "period": 60 } },
    { "name": "COACH_TOTAL_LIMIT", "namespace_id": "6521902", "simple": { "limit": 20, "period": 60 } }
  ],
  "assets": {
    "directory": "./dist-app-preview",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"]
  }
}
